{
  "name": "n8n-nodes-globiguard",
  "version": "1.1.0",
  "description": "GlobiGuard n8n community node with install registration and governed-action checkpoints.",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": "GuideGDM",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/globiguard/globiguard-open.git",
    "directory": "packages/n8n-nodes-globiguard"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/GlobiGuardApi.credentials.cjs"
    ],
    "nodes": [
      "dist/nodes/GlobiGuard/GlobiGuard.node.cjs",
      "dist/nodes/GlobiGuardDetect/GlobiGuardDetect.node.cjs",
      "dist/nodes/GlobiGuardAiAgent/GlobiGuardAiAgent.node.cjs"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@globiguard/contracts": "^1.0.1",
    "@globiguard/sdk": "^2.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "n8n-workflow": "^1.95.3"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.95.3 <2"
  },
  "scripts": {
    "build:deps": "pnpm --dir ../contracts build && pnpm --dir ../sdk build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:cjs": "esbuild src/nodes/GlobiGuard/GlobiGuard.node.ts src/nodes/GlobiGuardDetect/GlobiGuardDetect.node.ts src/nodes/GlobiGuardAiAgent/GlobiGuardAiAgent.node.ts src/credentials/GlobiGuardApi.credentials.ts --bundle --platform=node --format=cjs --target=node22 --external:n8n-workflow --outbase=src --outdir=dist --out-extension:.js=.cjs",
    "build": "pnpm run clean && pnpm run build:deps && tsc -p tsconfig.json && pnpm run build:cjs",
    "postbuild": "node ./scripts/copy-n8n-artifacts.cjs",
    "typecheck": "pnpm run build:deps && tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run build"
  }
}
